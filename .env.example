# App
DATABASE_URL=postgres://postgres:postgres@localhost:15432/aicomic
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=ai_comic_session
SESSION_TTL_DAYS=30
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-please
# At least 32 random characters. Required before saving model profiles.
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-different-long-random-secret

# Optional cost preview shown before queued generation.
GENERATION_COST_CURRENCY=USD
GENERATION_COST_PER_FRAME=
GENERATION_COST_PER_VIDEO=
GENERATION_COST_PER_ASSEMBLY=

# Feature rollout flags
TASK_ENGINE_V2=true
TASK_WORKER_MODE=embedded
NEXT_PUBLIC_STUDIO_WORKSPACE_V2=true

STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# S3-compatible storage (required when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
